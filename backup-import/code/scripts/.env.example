# Secrets LOCAUX - NE JAMAIS commiter ce fichier (il est dans .gitignore)
# Copie ce fichier en .env et remplis les valeurs.
# Recupere le token depuis BotFather pour ton bot Telegram
TELEGRAM_TOKEN=TON_TOKEN_ICI
# ID du groupe de signaux (supergroup Telegram, format -100...)
TELEGRAM_CHAT_ID=-100TON_ID_ICI
# Tes user_id Telegram en tant qu'admin (separes par virgule si plusieurs)
ADMIN_IDS=TON_USER_ID_ICI
